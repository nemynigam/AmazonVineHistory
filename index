<!DOCTYPE html>
<html lang="hi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Live Interactive Data Dashboard</title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-color: #0b1120;
      --card-bg: #1e293b;
      --accent-gradient: linear-gradient(135deg, #6366f1 0%, #a855f7 50%, #ec4899 100%);
      --header-grad: linear-gradient(135deg, #1e1b4b 0%, #312e81 100%);
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --border-color: rgba(255, 255, 255, 0.08);
    }
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Plus Jakarta Sans', sans-serif; }
    body { background-color: var(--bg-color); color: var(--text-main); padding: 25px 20px; min-height: 100vh; }
    .container { max-width: 1300px; margin: 0 auto; }
    .top-bar {
      display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px;
      margin-bottom: 25px; background: #111827; padding: 18px 24px; border-radius: 16px;
      border: 1px solid var(--border-color); box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
    }
    .title-area h1 {
      font-size: 22px; font-weight: 700; background: var(--accent-gradient);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    }
    .status-badge {
      display: inline-flex; align-items: center; gap: 8px; background: rgba(16, 185, 129, 0.15);
      border: 1px solid rgba(16, 185, 129, 0.3); color: #34d399; padding: 6px 14px;
      border-radius: 9999px; font-size: 13px; font-weight: 600;
    }
    .pulse-dot {
      width: 8px; height: 8px; background: #10b981; border-radius: 50%;
      box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); animation: pulse 1.6s infinite;
    }
    @keyframes pulse {
      0% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
      70% { box-shadow: 0 0 0 10px rgba(16, 185, 129, 0); }
      100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
    }
    .controls { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; gap: 15px; flex-wrap: wrap; }
    .search-box { position: relative; flex: 1; max-width: 400px; }
    .search-box input {
      width: 100%; padding: 12px 16px 12px 40px; background: #1e293b; border: 1px solid var(--border-color);
      border-radius: 12px; color: white; font-size: 14px; outline: none;
    }
    .search-box input:focus { border-color: #6366f1; }
    .search-icon { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--text-muted); }
    .row-counter { font-size: 14px; color: var(--text-muted); }
    .table-wrapper {
      background: var(--card-bg); border-radius: 16px; overflow: hidden;
      border: 1px solid var(--border-color); box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.4);
    }
    .table-scroll { overflow-x: auto; max-height: 70vh; }
    table { width: 100%; border-collapse: collapse; text-align: left; }
    th {
      background: var(--header-grad); color: #e0e7ff; font-weight: 600; font-size: 13px;
      text-transform: uppercase; padding: 16px 20px; border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      position: sticky; top: 0; z-index: 10; white-space: nowrap;
    }
    td { padding: 14px 20px; font-size: 14px; border-bottom: 1px solid var(--border-color); color: #e2e8f0; white-space: nowrap; }
    tr:nth-child(even) td { background: rgba(255, 255, 255, 0.015); }
    tr:hover td { background: rgba(99, 102, 241, 0.08); color: #ffffff; }
    .cell-pill { display: inline-block; padding: 4px 10px; border-radius: 6px; font-size: 12px; font-weight: 600; background: rgba(56, 189, 248, 0.15); color: #38bdf8; }
    .state-container { text-align: center; padding: 60px 20px; color: var(--text-muted); }
    .spinner {
      border: 3px solid rgba(255,255,255,0.1); width: 36px; height: 36px;
      border-radius: 50%; border-left-color: #6366f1; animation: spin 1s linear infinite; margin: 0 auto 15px;
    }
    @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
    .footer-bar { margin-top: 15px; display: flex; justify-content: space-between; font-size: 13px; color: var(--text-muted); }
  </style>
</head>
<body>
<div class="container">
  <div class="top-bar">
    <div class="title-area">
      <h1>⚡ Live Data Monitor</h1>
    </div>
    <div class="status-badge">
      <div class="pulse-dot"></div>
      LIVE AUTO-SYNC (2s)
    </div>
  </div>

  <div class="controls">
    <div class="search-box">
      <span class="search-icon">🔍</span>
      <input type="text" id="searchInput" placeholder="Search across all records..." onkeyup="filterData()">
    </div>
    <div class="row-counter" id="rowCount">Loading data...</div>
  </div>

  <div class="table-wrapper">
    <div class="table-scroll">
      <div id="loading" class="state-container">
        <div class="spinner"></div>
        <p>Connecting to Google Sheet...</p>
      </div>
      <table id="dataTable" style="display: none;">
        <thead id="tableHead"></thead>
        <tbody id="tableBody"></tbody>
      </table>
    </div>
  </div>

  <div class="footer-bar">
    <span id="syncStatus">Syncing...</span>
    <span id="lastUpdated">Last Update: --</span>
  </div>
</div>

<script>
  const SHEET_ID = "1nzoYDw45bUiZ5dD-q6n78NNpsLufNUDBkgKOQPAAh-M";
  const GVIZ_URL = `https://docs.google.com/spreadsheets/d/${SHEET_ID}/gviz/tq?tqx=out:json`;
  let fullData = [];

  async function fetchLiveUpdates() {
    try {
      const response = await fetch(`${GVIZ_URL}&t=${Date.now()}`);
      const text = await response.text();
      const jsonString = text.substring(text.indexOf("{"), text.lastIndexOf("}") + 1);
      const json = JSON.parse(jsonString);

      const cols = json.table.cols.map(c => c ? c.label || "Column" : "Column");
      const rows = json.table.rows.map(r => r.c.map(cell => cell ? (cell.f ? cell.f : cell.v) : ""));

      fullData = [cols, ...rows];
      renderTable(fullData);
      document.getElementById("syncStatus").innerHTML = "🟢 Connected & Live";
      document.getElementById("lastUpdated").innerText = "Last Updated: " + new Date().toLocaleTimeString();
    } catch (err) {
      document.getElementById("syncStatus").innerHTML = "🟡 Syncing...";
    }
  }

  function renderTable(data) {
    if (!data || data.length === 0) return;
    document.getElementById("loading").style.display = "none";
    const table = document.getElementById("dataTable");
    table.style.display = "table";

    const thead = document.getElementById("tableHead");
    const tbody = document.getElementById("tableBody");
    const headers = data[0];
    const rows = data.slice(1);

    if (thead.innerHTML === "") {
      let headHtml = "<tr>";
      headers.forEach(h => { headHtml += `<th>${h || '-'}</th>`; });
      headHtml += "</tr>";
      thead.innerHTML = headHtml;
    }

    const searchTerm = document.getElementById("searchInput").value.toLowerCase();
    let bodyHtml = "";
    let visibleCount = 0;

    rows.forEach(row => {
      const match = row.some(cell => String(cell).toLowerCase().includes(searchTerm));
      if (match) {
        visibleCount++;
        bodyHtml += "<tr>";
        row.forEach(cell => {
          let content = cell !== null && cell !== undefined ? cell : "";
          if (typeof content === 'number' || (!isNaN(content) && content !== '')) {
            content = `<span class="cell-pill">${content}</span>`;
          }
          bodyHtml += `<td>${content}</td>`;
        });
        bodyHtml += "</tr>";
      }
    });

    tbody.innerHTML = bodyHtml;
    document.getElementById("rowCount").innerText = `Showing ${visibleCount} of ${rows.length} rows`;
  }

  function filterData() { renderTable(fullData); }
  fetchLiveUpdates();
  setInterval(fetchLiveUpdates, 2000); // 2 सेकंड ऑटो-रिफ्रेश
</script>
</body>
</html>
